# The settings of the API, the worker and migrate (lesson 39.6). Copy this file to news.env.
# No passwords in it: the *_FILE lines name files that Compose mounts from secrets/.
# In Compose each service is reached by its name: db for the archive, cache for Redis.
DAILYPULSE_EDITION=city
DAILYPULSE_LOG_LEVEL=INFO
DAILYPULSE_EDITOR_KEY_FILE=/run/secrets/editor_key
DAILYPULSE_DB_HOST=db
DAILYPULSE_DB_NAME=archive
DAILYPULSE_DB_USER=news
DAILYPULSE_DB_PASSWORD_FILE=/run/secrets/db_password
DAILYPULSE_REDIS_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1
